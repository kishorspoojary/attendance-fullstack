// ============================================================================
// PRISMA SCHEMA — the blueprint for every table in the database.
//
// If you've never seen Prisma before: each "model" below becomes a real
// database table. Prisma reads this file and generates JavaScript functions
// (like `prisma.student.create(...)`) that we use everywhere in server/src.
//
// Quick vocabulary:
//   @id           → this field is the table's primary key
//   @default(...) → the value a field gets if you don't supply one
//   @unique       → no two rows may share this value
//   @relation     → this field links to a row in another table (a foreign key)
//   String?       → the "?" means this field is optional (can be null)
//   Json          → a flexible field holding any JSON, for small nested data
//
// IMPORTANT MODELING NOTE — there are two unrelated "floor" concepts in this
// app, and this schema keeps them as two separate models on purpose:
//   - CollegeFloor: a floor of the academic building. Holds Classrooms.
//     Discipline Officers and Lecturers are assigned to a
//     CollegeFloor (pooled — several staff can share one).
//   - HostelFloor: a floor of a specific Hostel. Holds HostelRooms.
//     Wardens are assigned to a HostelFloor too (pooled — several Wardens
//     can share one), responsible for every room on it. This used to be
//     modeled as room-level (User.roomIds), but every real Warden's
//     coverage turned out to always be "every room on one or more whole
//     floors" anyway (confirmed via server/src/reportWardenCoverage.js
//     before this migration) — floor-level is what the role actually means.
// Never merge these into one "Floor" model — a Warden's floor and a DO's
// floor are genuinely different hierarchies (Hostel → Floor → Room vs.
// College → Floor → Classroom) even though people casually call both "floor,"
// and User.floorIds holds one or the other depending entirely on role (see
// below) — never both at once for the same person.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PRINCIPAL
  AO
  COORDINATOR
  DB_MANAGER
  WARDEN
  DO
  LECTURER
  LAI
}

// An account's lifecycle. Every non-Principal account is created by someone
// else, so it needs a state beyond a simple on/off switch:
//   PENDING  → DB Manager proposed this staff account; waiting on AO approval
//   ACTIVE   → can log in normally
//   FROZEN   → AO paused this account; cannot log in until unfrozen
//   REJECTED → AO declined the account request; cannot log in, kept for record
enum AccountStatus {
  PENDING
  ACTIVE
  FROZEN
  REJECTED
}

// Every person who can log in — one table for all eight roles, distinguished
// by the `role` field. Login is by `loginKey` + password, not username —
// there is no username field in this app at all.
//
// loginKey and passwordHash split two different jobs that used to blur
// together: loginKey is a permanent, non-secret identifier — set once at
// creation by whoever creates the account, never reset, safe to display in
// plain text. passwordHash is the actual credential — an authority never
// chooses it directly, only ever a generated temp value (account creation,
// or Reset Password) that the owner must replace with one only they know.
model User {
  id              String        @id @default(cuid())
  name            String
  loginKey        String        @unique // 4-digit numeric string, e.g. "4821" — see auth.js keygen. Permanent — no reset flow.
  passwordHash    String // bcrypt hash of the real secret — starts as a generated temp password, never a shared constant
  mustSetPassword Boolean       @default(true) // true while still on a generated temp password (fresh creation or after Reset Password) — cleared once the owner sets their own
  role            Role
  status          AccountStatus @default(ACTIVE) // Principal + leadership start ACTIVE; DB-Manager-created staff start PENDING
  createdAt       DateTime      @default(now())

  // Scope of responsibility — which fields matter depends on the role:
  // floorIds is shared by two roles that never coexist on the same person,
  // holding a DIFFERENT floor type depending on which: Warden -> HostelFloor
  // ids they cover (pooled), DO / Lecturer -> CollegeFloor ids they cover
  // (pooled). See the IMPORTANT MODELING NOTE above — always resolve
  // against the right model for req.user.role, never assume one or the other.
  floorIds Json @default("[]")
  classIds Json @default("[]") // LAI: Classroom ids they cover

  pendingChanges PendingChange[]
}

// ---------------------------------------------------------------- Hostel side
model Hostel {
  id     String        @id @default(cuid())
  name   String
  floors HostelFloor[]
}

model HostelFloor {
  id       String       @id @default(cuid())
  name     String
  hostelId String
  hostel   Hostel       @relation(fields: [hostelId], references: [id])
  rooms    HostelRoom[]
}

model HostelRoom {
  id            String      @id @default(cuid())
  roomNo        String
  hostelFloorId String
  hostelFloor   HostelFloor @relation(fields: [hostelFloorId], references: [id])
  students      Student[]
}

// ---------------------------------------------------------------- College side
model CollegeFloor {
  id         String      @id @default(cuid())
  name       String
  classrooms Classroom[]
  // Optional, Lecturer-set target time for the day's attendance to be done
  // by, "HH:MM" 24-hour local time (e.g. "14:00") — shared by everyone
  // pooled on this floor (DOs/Lecturers all see the same one, since
  // CollegeFloor is a pooled assignment for those two roles — see the
  // modeling note at the top of this file; Wardens pool on HostelFloor
  // instead, a different hierarchy, and Coordinator isn't floor-bound at
  // all). Purely advisory/gating, not a scheduler: this
  // app has no cron, so nothing fires automatically when it passes. Once
  // passed, it unlocks a floor-scoped version of Coordinator's global
  // /attendance/:date/cutoff for any Lecturer on this floor — see
  // routes/attendance.js's /floor-cutoff.
  dailyDeadline String?
}

// "Classroom" is what the code calls it; to staff this is a "class" or
// "batch" — interchangeable words for the same thing, not two concepts.
model Classroom {
  id             String             @id @default(cuid())
  name           String
  year           Int? // 1-2, optional — the program is permanently 2 years; not every class is year-based, and this was retrofitted after existing classes already had names with no structured year
  collegeFloorId String
  collegeFloor   CollegeFloor       @relation(fields: [collegeFloorId], references: [id])
  students       Student[]
  attendanceRecords AttendanceRecord[]
}

model Student {
  id      String      @id @default(cuid())
  // A plain, DB-assigned, strictly-increasing insertion-order counter.
  // Needed because neither of the two "obvious" tiebreakers actually work
  // here: this model has no createdAt, and even if it did, every row in one
  // bulk import shares the same value (Postgres's now()/CURRENT_TIMESTAMP
  // is constant for the whole transaction, not per-statement) — while
  // cuid() id ordering isn't a documented guarantee this app can rely on.
  // Every listing that must preserve entry order (Students admin, the
  // browse-students views, Excel export) orders by this field instead of
  // roll number. Existing rows got backfilled in whatever order Postgres
  // happened to pick — their original entry order isn't recoverable — but
  // every row created from here on is correctly ordered.
  seq     Int         @default(autoincrement())
  name    String
  // Globally unique across the whole college (confirmed institution rule —
  // no per-class exceptions), enforced here as the safety net UNDER the
  // application-level checks (studentApproval.js's findRollOwner and every
  // caller of it), not instead of them: this constraint is case-sensitive
  // (a straight @unique — server/src/reportGlobalDuplicateRolls.js found
  // zero existing collisions of any kind, including case-only, so there was
  // no real data forcing a normalized-column approach), while the
  // application-level checks are case-insensitive and trimmed. A duplicate
  // that differs only by letter case would still be caught in virtually
  // every real scenario by the application checks; this constraint's job is
  // catching a write that skipped them entirely (a future code path bug, or
  // two concurrent approvals racing past both checks at once), not that
  // narrower case-only race — see the migration this comment ships with.
  roll    String      @unique
  classId String
  class   Classroom   @relation(fields: [classId], references: [id])
  roomId  String? // null means "day scholar" — no hostel room
  room    HostelRoom? @relation(fields: [roomId], references: [id])

  // Explicit "local student" (day scholar) tag. Kept as its own field rather
  // than just inferring it from roomId being empty, because it decides who's
  // responsible for this student day to day: a Local Attendance Incharge for
  // local students, a Warden for hostellers. applyChange.js defaults it from
  // roomId when a Database Manager doesn't set it explicitly (no room = local).
  isLocal Boolean @default(true)

  // Persistent "away" status (e.g. went home). Once a Warden sets this, the
  // student counts as absent automatically every day — no re-marking needed —
  // until a Warden clears it via the "report back" action.
  awayReason String?
  awaySince  String?
}

// The Database Manager never edits students/rooms/staff/hostels directly.
// Every edit becomes a row here with status "pending", and only takes real
// effect once an AO approves it (see applyChange.js). This is the two-person
// control the workflow calls for, and it's also how new staff accounts
// (Warden/LAI/DO/Lecturer) get created — see type "create_staff".
model PendingChange {
  id            String   @id @default(cuid())
  // e.g. "add_student", "create_staff", "bulk_add_students" — see applyChange.js.
  // "structure_batch" is the one type that bundles many creates (hostels ->
  // floors -> rooms, college floors -> classrooms) into a single row instead
  // of one PendingChange per item — see structureBatch.js and applyChange.js.
  type          String
  summary       String // short human-readable description shown in the AO's queue
  payload       Json // the data needed to apply the change; shape depends on `type`
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  // pending | approved | rejected | sent_back (sent_back is structure_batch-only —
  // see routes/structure.js; other types only ever get approved/rejected)
  status        String   @default("pending")
  reason        String? // why an AO rejected it, or why a structure_batch was sent back for edits
  createdAt     DateTime @default(now())
}

// Twice a day: every classroom gets one independent AttendanceRecord per
// session, running the exact same pipeline (headcount through
// teacherApproved) separately for each. Nothing about a session's
// approval or absentee state is shared with the other session for the
// same class/date — they're two full, unrelated rows that happen to share
// a date and classId.
enum Session {
  MORNING
  AFTERNOON
}

// One row per classroom per day per session — the heart of the daily workflow.
// The chain is exactly two stages now (AO does not approve daily attendance,
// and neither does Coordinator anymore — see stages.js):
//   doApproved  →  teacherApproved  →  published
// Each *Approved field holds a small object like
// { by: "userId", byName: "Priya", at: "2026-07-04T09:15:00.000Z" }, or stays
// null until that stage happens. coordinatorApproved still exists as a real
// column (genuine historical data from the old three-stage pipeline) but
// isn't part of the live pipeline anymore — see stages.js's comment for why
// old fully-approved records still read correctly as published without it.
//
// The DO's own work happens in two separate windows, at two different
// times of day, because a DO walking into a classroom mid-period can check
// who's physically absent right then, but can't phone anyone's home or
// warden until later:
//   Window 1 (in the classroom): headcount + doConfirmed — "yes, this
//     student really is absent" (or correct-presence, if they're not).
//   Window 2 (later, on the phone): doVerified — the actual reason, only
//     settable once a student is doConfirmed. See routes/attendance.js.
model AttendanceRecord {
  id      String    @id @default(cuid())
  date    String // "YYYY-MM-DD"
  classId String
  class   Classroom @relation(fields: [classId], references: [id])
  session Session  @default(MORNING) // existing rows predate sessions and were backfilled as MORNING — see the migration this ships with

  headcount      Int? // physical count the DO enters before they can approve
  wardenAbsences Json @default("{}") // { studentId: {by, byName, at, reason, isLocal} } — isLocal is a snapshot of the student's boarding status at the moment they were marked absent, not a live lookup
  laiAbsences    Json @default("{}") // { studentId: {by, byName, at, reason: null, isLocal} } — LAI never sets a reason; isLocal snapshot same as wardenAbsences

  doConfirmed Json @default("{}") // { studentId: {by, byName, at} } — Window 1: confirmed absent in the classroom
  doVerified  Json @default("{}") // { studentId: {reason, verifiedBy, verifiedByName, at} } — Window 2: reason after calling

  doApproved          Json?
  teacherApproved      Json?
  coordinatorApproved Json?
  // Optional, additive — a second Lecturer on the same floor voluntarily
  // co-signing a class teacherApproved already covers. Never required,
  // never gates anything downstream — the class is already fully published
  // once teacherApproved is set, nothing else in the pipeline waits on
  // this; purely a visible second set of eyes for classes someone wants
  // extra confidence on. Only
  // settable once teacherApproved exists, and only by a Lecturer other than
  // whoever set that — see routes/attendance.js's /co-sign.
  teacherCoSignedBy Json? // { by, byName, at } — same shape as the *Approved fields

  // If the deadline passes before every stage is done, Coordinator's cutoff
  // action can force this record to "publish" anyway — but never bypasses
  // the DO stage (see routes/attendance.js). skippedStages then records
  // exactly which later stage(s) were skipped.
  forcedPublish Boolean @default(false)
  skippedStages Json    @default("[]")

  // Send-back: when a stage (DO/Lecturer) rejects what's in front
  // of them instead of approving it, this records why, so whoever receives
  // it understands the problem. Cleared once the record moves forward again.
  // { fromStage, fromName, toStage, reason, at }
  sentBack Json?

  @@unique([date, classId, session])
}
